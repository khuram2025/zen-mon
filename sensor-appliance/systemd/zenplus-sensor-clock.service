[Unit]
Description=Initialize ZenPlus sensor appliance UTC
DefaultDependencies=no
Wants=local-fs.target
After=local-fs.target
Before=cloud-init-local.service network-pre.target time-sync.target zenplus-sensor.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/zenplus-sensor/initialize-clock.py
RemainAfterExit=yes
TimeoutStartSec=75
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=CAP_SYS_TIME CAP_SYS_MODULE

[Install]
WantedBy=sysinit.target

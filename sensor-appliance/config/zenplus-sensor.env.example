# ZenPlus remote sensor runtime configuration.
# The NoCloud seed or manual setup writes /etc/zenplus-sensor/sensor.env.

ZENPLUS_SERVER_URL=https://controller.example.com
ZENPLUS_ENROLLMENT_TOKEN=zps_enr_replace_me
ZENPLUS_SENSOR_NAME=branch-01
ZENPLUS_VERIFY_TLS=1

# Runtime paths
ZENPLUS_SENSOR_STATE_DIR=/var/lib/zenplus-sensor
ZENPLUS_SENSOR_LOG_LEVEL=info

# Local scheduler defaults. Controller config can override per check.
ZENPLUS_HEARTBEAT_INTERVAL_SECONDS=30
ZENPLUS_CONFIG_POLL_INTERVAL_SECONDS=60
ZENPLUS_UPLOAD_INTERVAL_SECONDS=10
ZENPLUS_MAX_WORKERS=100

# Local spool limits
ZENPLUS_SPOOL_MAX_MB=512
ZENPLUS_SPOOL_RETENTION_HOURS=72

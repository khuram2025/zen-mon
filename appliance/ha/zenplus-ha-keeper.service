[Unit]
Description=ZenPlus analytics coordination quorum
After=network-online.target
Wants=network-online.target

[Service]
User=zenplus
Group=zenplus
ExecStart=/usr/local/bin/clickhouse keeper --config-file=/etc/zenplus-ha/analytics/keeper.xml
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zenplus-ha/analytics
UMask=0077

[Install]
WantedBy=multi-user.target

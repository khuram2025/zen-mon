# Build toolchains — downloaded/extracted on demand by build.cmd, ~460MB.
# go1.26.x.windows-amd64.zip and the tree it unpacks to are reproducible from
# go.mod; keeping them in git would blow past GitHub's 100MB file limit.
.tools/
tools/

# Build output: signed MSI/EXE installers and compiled binaries. Release
# artifacts are published to the controller via
# /api/v1/agent-fleet/packages/publish, not tracked here.
dist/

# Local Go compiler cache used by release builds.
.gotmp/

# Per-machine runtime state written by a running agent: enrolled identity,
# metric spool, and logs. Machine-specific and not reproducible; committing it
# would also leak the enrolled host's identity into the repo.
data/

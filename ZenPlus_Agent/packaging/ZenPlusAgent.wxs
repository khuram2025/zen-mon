<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="ZenPlus Agent"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="Zentryc"
    UpgradeCode="a605ea5d-025b-44c5-8823-3aa58eb66a21">

    <Package
      InstallerVersion="500"
      Platform="x64"
      Compressed="yes"
      InstallScope="perMachine"
      InstallPrivileges="elevated"
      Description="ZenPlus Agent Windows installer" />

    <MajorUpgrade Schedule="afterInstallValidate" DowngradeErrorMessage="A newer version of ZenPlus Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProductIcon" SourceFile="$(var.AssetsDir)\zenplus-agent.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://zentryc.com/zenplus/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://zentryc.com/downloads/zenplus-agent/" />
    <Property Id="ARPHELPLINK" Value="https://zentryc.com/contact/" />
    <Property Id="ARPCONTACT" Value="support@zentryc.com" />
    <Property Id="CONTROLLER_URL" Secure="yes" />
    <Property Id="INSTALL_PROFILE" Value="combined" Secure="yes" />
    <Property Id="PURGE" Secure="yes" />
    <Property Id="InstallViaExe" Hidden="yes" />

    <SetProperty
      Id="ARPINSTALLLOCATION"
      Value="[INSTALLFOLDER]"
      Sequence="execute"
      After="CostFinalize">NOT Installed</SetProperty>

    <Binary Id="ZenPlusAgentSetupExe" SourceFile="$(var.SetupExe)" />

    <SetProperty
      Id="InstallViaExe"
      Value="/machine /quiet /norestart /managed-by-msi CONTROLLER_URL=&quot;[CONTROLLER_URL]&quot; INSTALL_PROFILE=&quot;[INSTALL_PROFILE]&quot;"
      Sequence="execute"
      Before="InstallViaExe">NOT Installed AND NOT REMOVE</SetProperty>
    <SetProperty
      Id="WixShellExecTarget"
      Value="[ProgramFiles64Folder]ZenPlus\Agent\zenplus-agent-app.exe"
      Sequence="execute"
      Before="LaunchDashboard">NOT Installed AND UILevel &gt;= 4</SetProperty>
    <CustomAction
      Id="InstallViaExe"
      BinaryKey="ZenPlusAgentSetupExe"
      ExeCommand="[InstallViaExe]"
      Execute="deferred"
      Return="check"
      Impersonate="no"
      HideTarget="yes" />

    <SetProperty
      Id="UninstallViaExe"
      Value="&quot;[ProgramFiles64Folder]ZenPlus\Agent\ZenPlusAgentSetup.exe&quot; /uninstall /quiet /machine /managed-by-msi PURGE=&quot;[PURGE]&quot;"
      Sequence="execute"
      Before="UninstallViaExe">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE</SetProperty>
    <CustomAction
      Id="UninstallViaExe"
      Directory="TARGETDIR"
      ExeCommand="[UninstallViaExe]"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />

    <CustomAction
      Id="LaunchDashboard"
      BinaryKey="WixCA"
      DllEntry="WixShellExec"
      Execute="immediate"
      Return="ignore"
      Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="InstallViaExe" After="InstallInitialize">NOT Installed AND NOT REMOVE</Custom>
      <!-- A major upgrade must leave the standalone installation in place for
           the incoming setup custom action to update synchronously. Running
           the old self-uninstaller here races the new installer. -->
      <Custom Action="UninstallViaExe" After="InstallViaExe">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="LaunchDashboard" After="InstallFinalize">NOT Installed AND UILevel &gt;= 4</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="CompanyFolder" Name="ZenPlus">
          <Directory Id="INSTALLFOLDER" Name="Agent">
            <Component Id="MsiRegistryAnchor" Guid="dfac707f-a59f-4059-b139-734365363bfb" Win64="yes">
              <RegistryValue
                Root="HKLM"
                Key="Software\ZenPlus\AgentMsi"
                Name="Installed"
                Type="integer"
                Value="1"
                KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="ZenPlus Agent" Level="1">
      <ComponentRef Id="MsiRegistryAnchor" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsDir)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\installer-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\installer-dialog.bmp" />
  </Product>
</Wix>

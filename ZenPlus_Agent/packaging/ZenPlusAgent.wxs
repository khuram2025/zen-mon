<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="ZenPlus Agent"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="ZenPlus"
    UpgradeCode="a605ea5d-025b-44c5-8823-3aa58eb66a21">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      InstallPrivileges="elevated"
      Description="ZenPlus Agent Windows installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ZenPlus Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <Property Id="CONTROLLER_URL" Secure="yes" />
    <!--
      Default value is a fixed-width placeholder that the controller rewrites
      in place when an operator downloads the package, so each download
      carries an enrollment token sized to that rollout. Enrollment tokens are
      always exactly 40 chars ("zpa_enr_" + 32), matching this placeholder
      byte for byte, which keeps the MSI's compound-file layout and string
      pool valid without a rebuild. Do not change its length.
      Passing ENROLLMENT_TOKEN on the msiexec command line still overrides it.
    -->
    <Property Id="ENROLLMENT_TOKEN" Secure="yes" Hidden="yes" Value="zpa_enr_PLACEHOLDERTOKENPLACEHOLDERTOKEN" />
    <Property Id="SITE_ID" Secure="yes" />
    <Property Id="POLICY_ID" Secure="yes" />
    <Property Id="PURGE" Secure="yes" />

    <Binary Id="ZenPlusAgentSetupExe" SourceFile="$(var.SetupExe)" />

    <CustomAction
      Id="SetInstallViaExe"
      Property="InstallViaExe"
      Value="/machine /quiet /norestart CONTROLLER_URL=&quot;[CONTROLLER_URL]&quot; ENROLLMENT_TOKEN=&quot;[ENROLLMENT_TOKEN]&quot; SITE_ID=&quot;[SITE_ID]&quot; POLICY_ID=&quot;[POLICY_ID]&quot;" />
    <CustomAction
      Id="InstallViaExe"
      BinaryKey="ZenPlusAgentSetupExe"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <CustomAction
      Id="SetUninstallViaExe"
      Property="UninstallViaExe"
      Value="&quot;[ProgramFilesFolder]ZenPlus\Agent\ZenPlusAgentSetup.exe&quot; /uninstall /quiet /machine" />
    <CustomAction
      Id="UninstallViaExe"
      Directory="TARGETDIR"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="SetInstallViaExe" After="CostFinalize">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="SetUninstallViaExe" After="SetInstallViaExe">REMOVE="ALL"</Custom>
      <Custom Action="UninstallViaExe" After="InstallInitialize">REMOVE="ALL"</Custom>
      <Custom Action="InstallViaExe" After="UninstallViaExe">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="CompanyFolder" Name="ZenPlus">
          <Directory Id="INSTALLFOLDER" Name="Agent">
            <Component Id="MsiRegistryAnchor" Guid="dfac707f-a59f-4059-b139-734365363bfb">
              <RegistryValue
                Root="HKLM"
                Key="Software\ZenPlus\AgentMsi"
                Name="Installed"
                Type="integer"
                Value="1"
                KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="ZenPlus Agent" Level="1">
      <ComponentRef Id="MsiRegistryAnchor" />
    </Feature>
  </Product>
</Wix>

# Database
POSTGRES_PASSWORD=zenplus_dev
CLICKHOUSE_PASSWORD=clickhouse_dev
REDIS_PASSWORD=redis_dev

# Commissioned controller HA only. Leave unset for standalone deployments.
# The root supervisor owns the grant; an absent/expired grant refuses requests.
# ZENPLUS_CONTROLLER_GRANT=/run/zenplus-controller/grant.json
# DATABASE_SSL_ROOT_CERT=/etc/zenplus-ha/tls/ca.crt
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/etc/zenplus-ha/tls/ca.crt
# Enable only after independent site identity, local provider access and peer
# authorization are commissioned. Unknown remote outcomes are held for review.
# NOTIFICATION_SITE_ROUTING_ENABLED=false

# API
# At least 32 random characters. The API refuses to start while JWT_SECRET or a
# datastore password is the placeholder "changeme" (development override:
# ZENPLUS_ALLOW_INSECURE_DEFAULTS=1).
JWT_SECRET=change-me-to-a-random-64-character-string-in-production
API_PORT=8000

# SNMP credential encryption — 32-byte key, hex or base64.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Rotate via scripts/rotate-snmp-key.sh (added in a later phase).
# WARNING: changing this key invalidates all stored SNMPv3 passphrases.
SNMP_ENC_KEY=

# Poller
POLLER_ID=poller-01

# Frontend
VITE_API_URL=http://localhost:8000

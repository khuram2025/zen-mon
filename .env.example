# Database
POSTGRES_PASSWORD=zenplus_dev
CLICKHOUSE_PASSWORD=clickhouse_dev
REDIS_PASSWORD=redis_dev

# Commissioned controller HA only. Leave unset for standalone deployments.
# The root supervisor owns the grant; an absent/expired grant refuses requests.
# ZENPLUS_CONTROLLER_GRANT=/run/zenplus-controller/grant.json
# DATABASE_SSL_ROOT_CERT=/etc/zenplus-ha/tls/ca.crt
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/etc/zenplus-ha/tls/ca.crt
# Enable only after independent site identity, local provider access and peer
# authorization are commissioned. Unknown remote outcomes are held for review.
# NOTIFICATION_SITE_ROUTING_ENABLED=false
# Lab qualification only: requires migration 175 and bounded replicated-table
# deduplication policy. Do not enable on an unqualified customer appliance.
# HOST_INSERT_JOURNAL_ENABLED=0
# POLLER_INSERT_JOURNAL_ENABLED=0
# TRAP_INCIDENT_INBOX_ENABLED=0
# APM_INSERT_JOURNAL_ENABLED=0
# RUM_INSERT_JOURNAL_ENABLED=0
# NETFLOW_INSERT_JOURNAL_ENABLED=0
# Flow handoff requires the same NETFLOW_COLLECTOR_ID throughout a cell,
# HOST_INSERT_JOURNAL_ENABLED=1 and commissioned controller admission.
# APM handoff requires host recovery and commissioned controller admission.
# It acknowledges the related trace tables after their PostgreSQL transaction;
# analytics query visibility follows asynchronously. See docs/apm-ingest-journal.md.
# Poller handoff requires HOST_INSERT_JOURNAL_ENABLED=1 on the API candidates
# and commissioned ZENPLUS_CONTROLLER_GRANT admission. Lab qualification only.
# Trap incidents require migration 178 and the poller journal. Enable the trap
# inbox on every API candidate before enabling it on the poller candidates.

# API
# At least 32 random characters. The API refuses to start while JWT_SECRET or a
# datastore password is the placeholder "changeme" (development override:
# ZENPLUS_ALLOW_INSECURE_DEFAULTS=1).
JWT_SECRET=change-me-to-a-random-64-character-string-in-production
API_PORT=8000

# SNMP credential encryption — 32-byte key, hex or base64.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Rotate via scripts/rotate-snmp-key.sh (added in a later phase).
# WARNING: changing this key invalidates all stored SNMPv3 passphrases.
SNMP_ENC_KEY=

# Poller
POLLER_ID=poller-01

# Frontend
VITE_API_URL=http://localhost:8000

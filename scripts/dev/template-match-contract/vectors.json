{
  "description": "Device template classification contract (docs/device-templates.md). Both poller/internal/checker/snmp (Go) and server/app/services/device_templates/classify.py (Python) must pick the expected template for every case. Rules: OIDs are normalised (leading dot, 'iso.' form); a prefix matches only on a dot boundary (equal, or followed by '.'); a template matches by prefix (strength 2) or, when no prefix of it matched, by sys_descr_regex (strength 1); with require_sys_descr a prefix hit counts only when sys_descr_regex also matches; candidates rank by match_priority (higher first), then strength, then the longest matching prefix, then name (byte order). An invalid regex never matches.",
  "templates": [
    {"id": "fortigate", "name": "Fortinet FortiGate", "match_priority": 100,
     "match_rules": {"sys_object_id_prefixes": ["1.3.6.1.4.1.12356.101.1", "1.3.6.1.4.1.12356"], "sys_descr_regex": "FortiGate|FortiOS"}},
    {"id": "fortigate_branch", "name": "FortiGate branch (customised)", "match_priority": 110,
     "match_rules": {"sys_object_id_prefixes": ["1.3.6.1.4.1.12356.101.1"], "sys_descr_regex": "FortiGate|FortiOS"}},
    {"id": "junos", "name": "Juniper JunOS", "match_priority": 100,
     "match_rules": {"sys_object_id_prefixes": ["1.3.6.1.4.1.2636"], "sys_descr_regex": "Juniper|JUNOS"}},
    {"id": "junos_srx", "name": "Juniper SRX", "match_priority": 100,
     "match_rules": {"sys_object_id_prefixes": ["1.3.6.1.4.1.2636.1.1.1.2"], "sys_descr_regex": "(?i)srx", "require_sys_descr": true}},
    {"id": "cisco_ios", "name": "Cisco IOS/IOS-XE Switch & Router", "match_priority": 100,
     "match_rules": {"sys_descr_regex": "(?i)(IOS Software|IOS-XE Software|NX-OS)"}},
    {"id": "cisco_asa", "name": "Cisco ASA Firewall", "match_priority": 100,
     "match_rules": {"sys_descr_regex": "(?i)Adaptive Security Appliance"}},
    {"id": "mikrotik", "name": "MikroTik RouterOS", "match_priority": 100,
     "match_rules": {"sys_object_id_prefixes": ["1.3.6.1.4.1.14988"], "sys_descr_regex": "(?i)RouterOS"}},
    {"id": "generic_linux_a", "name": "B Linux", "match_priority": 100,
     "match_rules": {"sys_descr_regex": "Linux"}},
    {"id": "generic_linux_b", "name": "A Linux", "match_priority": 100,
     "match_rules": {"sys_descr_regex": "Linux"}},
    {"id": "broken_regex", "name": "Broken regex", "match_priority": 900,
     "match_rules": {"sys_descr_regex": "([unclosed"}},
    {"id": "priority_descr", "name": "Lab override", "match_priority": 500,
     "match_rules": {"sys_descr_regex": "LAB-OVERRIDE"}},
    {"id": "no_rules", "name": "Manual only", "match_priority": 1000,
     "match_rules": {}}
  ],
  "cases": [
    {"name": "longest prefix wins at equal priority",
     "sys_object_id": "1.3.6.1.4.1.2636.1.1.1.2.39", "sys_descr": "Juniper Networks, Inc. ex4300", "expect": "junos"},
    {"name": "require_sys_descr: prefix plus descr match picks the specific template",
     "sys_object_id": "1.3.6.1.4.1.2636.1.1.1.2.39", "sys_descr": "Juniper Networks, Inc. srx340 internet router", "expect": "junos_srx"},
    {"name": "higher priority beats a longer prefix",
     "sys_object_id": ".1.3.6.1.4.1.12356.101.1.3004", "sys_descr": "FortiGate-60F v7.2.5", "expect": "fortigate_branch"},
    {"name": "iso. form is normalised",
     "sys_object_id": "iso.3.6.1.4.1.12356.15.1", "sys_descr": "FortiAnalyzer", "expect": "fortigate"},
    {"name": "prefix needs a dot boundary",
     "sys_object_id": "1.3.6.1.4.1.149880.1", "sys_descr": "something else", "expect": null},
    {"name": "exact prefix equal to the sysObjectID matches",
     "sys_object_id": "1.3.6.1.4.1.14988", "sys_descr": "", "expect": "mikrotik"},
    {"name": "prefix match beats a descr match at equal priority",
     "sys_object_id": "1.3.6.1.4.1.14988.1", "sys_descr": "RouterOS on Linux", "expect": "mikrotik"},
    {"name": "descr fallback with no sysObjectID",
     "sys_object_id": "", "sys_descr": "Cisco Adaptive Security Appliance Version 9.16(4)", "expect": "cisco_asa"},
    {"name": "descr ties break on name byte order",
     "sys_object_id": "1.3.6.1.4.1.8072.3.2.10", "sys_descr": "Linux host 5.15.0", "expect": "generic_linux_b"},
    {"name": "a higher-priority descr template wins over prefix matches",
     "sys_object_id": "1.3.6.1.4.1.12356.101.1.3004", "sys_descr": "FortiGate LAB-OVERRIDE", "expect": "priority_descr"},
    {"name": "invalid regex never matches and never errors",
     "sys_object_id": "1.3.6.1.4.1.99999", "sys_descr": "([unclosed", "expect": null},
    {"name": "templates without rules never match",
     "sys_object_id": "1.3.6.1.4.1.1", "sys_descr": "anything", "expect": null},
    {"name": "require_sys_descr without a descr match falls back to the broader template",
     "sys_object_id": "1.3.6.1.4.1.2636.1.1.1.2.39", "sys_descr": "", "expect": "junos"},
    {"name": "nothing matches",
     "sys_object_id": "1.3.6.1.4.1.311.1.1.3.1.2", "sys_descr": "Hardware: Intel64 - Software: Windows", "expect": null}
  ]
}

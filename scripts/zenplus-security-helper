#!/bin/bash
# /opt/zenplus/scripts/zenplus-security-helper
#
# Privileged TLS / web-security operations for the ZenPlus API. The API runs
# as the unprivileged `zenplus` user; /etc/sudoers.d/zenplus-security grants
# it NOPASSWD access to the root-owned installed copy of this script at
# /usr/local/sbin/zenplus-security-helper. Every subcommand validates its
# arguments before touching anything — this script is a security boundary.
#
# The API never passes file contents or free-form config through this script:
# certificate material is staged by the API at fixed paths under
# /opt/zenplus/data/tls-staging, and the nginx config is generated here from
# an embedded template driven by a small set of validated flags. The zenplus
# user therefore cannot use the sudo grant to install arbitrary files or
# inject nginx directives.
#
# Subcommands:
#   install-cert                      Validate the staged cert/key (+ optional
#                                     chain) and install into /etc/zenplus/tls
#   apply https=on|off redirect=on|off hsts=on|off min_tls=1.2|1.3
#                                     Regenerate the ZenPlus nginx site config,
#                                     test it, reload nginx, record state
#   remove-cert                       Remove the installed certificate (refused
#                                     while HTTPS is active)
#   status                            JSON: installed cert + applied config
set -euo pipefail

STAGING_DIR="/opt/zenplus/data/tls-staging"
TLS_DIR="/etc/zenplus/tls"
STATE_FILE="${TLS_DIR}/state.json"

err() { echo "[security-helper] ERROR: $*" >&2; exit 1; }

# The active nginx site config for ZenPlus. Hand-installed appliances use
# sites-available/zenplus; installer-provisioned ones use conf.d/zenplus.conf.
nginx_target() {
    if [ -e /etc/nginx/sites-enabled/zenplus ]; then
        echo /etc/nginx/sites-available/zenplus
    else
        echo /etc/nginx/conf.d/zenplus.conf
    fi
}

# ── Certificate validation ──────────────────────────────────────────────────

validate_pair() {
    local crt="$1" key="$2"
    openssl x509 -noout -in "$crt" >/dev/null 2>&1 \
        || err "staged certificate is not a valid PEM X.509 certificate"
    openssl pkey -noout -in "$key" >/dev/null 2>&1 \
        || err "staged private key is not a valid PEM key"
    local crt_pub key_pub
    crt_pub=$(openssl x509 -pubkey -noout -in "$crt" | sha256sum | cut -d' ' -f1)
    key_pub=$(openssl pkey -pubout -in "$key" 2>/dev/null | sha256sum | cut -d' ' -f1)
    [ "$crt_pub" = "$key_pub" ] || err "private key does not match the certificate"
}

# ── Nginx config template ───────────────────────────────────────────────────
# Emits the shared proxy/static locations into $1. Mirrors the stock ZenPlus
# site config (install.sh) — keep the two in sync when locations change.
emit_locations() {
    cat >> "$1" <<'EOF'

    # BEGIN ZenPlus host-results ingest timeout
    # Host inventory uploads must never inherit the long-lived /api/ timeout.
    # The API has a shorter internal processing deadline and returns a
    # retryable response before the agent's 30-second HTTP timeout expires.
    location = /api/v1/agents/results/host {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
    }
    # END ZenPlus host-results ingest timeout

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # OTLP ingest (APM): OpenTelemetry SDKs/Collectors POST to /v1/traces.
    location /v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 32m;
        proxy_read_timeout 120s;
    }

    # Hashed assets are immutable.
    location ~* ^/assets/.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
        root /opt/zenplus/dashboard/dist;
        expires 7d;
        include /etc/nginx/snippets/zenplus-security-headers.conf;
        include /etc/nginx/snippets/zenplus-management-access*.conf;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # SPA shell — must not be cached so new builds are picked up immediately.
    location / {
        root /opt/zenplus/dashboard/dist;
        include /etc/nginx/snippets/zenplus-security-headers.conf;
        include /etc/nginx/snippets/zenplus-management-access*.conf;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
    }

    location /health {
        access_log off;
        proxy_pass http://127.0.0.1:8000/api/v1/system/health;
    }

    location ~ /\. {
        deny all;
    }
EOF
}

emit_security_headers() {
    cat >> "$1" <<'EOF'
    include /etc/nginx/snippets/zenplus-security-headers.conf;
    server_tokens off;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    gzip_min_length 1000;
EOF
}

write_security_headers() {
    mkdir -p /etc/nginx/snippets
    cat > /etc/nginx/snippets/zenplus-security-headers.conf <<'EOF'
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; frame-src 'self' blob: https:; worker-src 'self' blob:; form-action 'self'" always;
EOF
    if [ "$1" = "on" ]; then
        echo 'add_header Strict-Transport-Security "max-age=15768000" always;' >> /etc/nginx/snippets/zenplus-security-headers.conf
    fi
    chmod 0644 /etc/nginx/snippets/zenplus-security-headers.conf
}

generate_config() {
    local out="$1" https="$2" redirect="$3" hsts="$4" min_tls="$5"
    write_security_headers "$hsts"

    cat > "$out" <<'EOF'
# Generated by zenplus-security-helper — do not edit by hand.
# Changes are managed from Settings -> General -> Security.
EOF

    # ── HTTP :80 ──
    {
        echo "server {"
        echo "    listen 80 default_server;"
        echo "    listen [::]:80 default_server;"
        echo "    server_name _;"
    } >> "$out"

    if [ "$https" = "on" ] && [ "$redirect" = "on" ]; then
        cat >> "$out" <<'EOF'

    # Health stays reachable over HTTP for load-balancer / monitor probes.
    location /health {
        access_log off;
        proxy_pass http://127.0.0.1:8000/api/v1/system/health;
    }

    location / {
        return 301 https://$host$request_uri;
    }
EOF
    else
        emit_security_headers "$out"
        emit_locations "$out"
    fi
    echo "}" >> "$out"

    # ── HTTPS :443 ──
    if [ "$https" = "on" ]; then
        {
            echo ""
            echo "server {"
            echo "    listen 443 ssl default_server;"
            echo "    listen [::]:443 ssl default_server;"
            # `http2 on;` requires nginx >= 1.25.1
            local ngx_ver
            ngx_ver=$(nginx -v 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            if [ -n "$ngx_ver" ] && printf '%s\n%s\n' "1.25.1" "$ngx_ver" | sort -V -C; then
                echo "    http2 on;"
            fi
            echo "    server_name _;"
            echo ""
            echo "    ssl_certificate ${TLS_DIR}/fullchain.pem;"
            echo "    ssl_certificate_key ${TLS_DIR}/server.key;"
            if [ "$min_tls" = "1.3" ]; then
                echo "    ssl_protocols TLSv1.3;"
            else
                echo "    ssl_protocols TLSv1.2 TLSv1.3;"
            fi
            echo "    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;"
            echo "    ssl_prefer_server_ciphers off;"
            echo "    ssl_session_timeout 1d;"
            echo "    ssl_session_cache shared:ZenPlusSSL:10m;"
            echo "    ssl_session_tickets off;"
        } >> "$out"
        emit_security_headers "$out"
        emit_locations "$out"
        echo "}" >> "$out"
    fi
}

# ── Subcommands ─────────────────────────────────────────────────────────────

case "${1:-}" in
    install-cert)
        [ $# -eq 1 ] || err "usage: install-cert (reads ${STAGING_DIR})"
        crt="${STAGING_DIR}/server.crt"
        key="${STAGING_DIR}/server.key"
        chain="${STAGING_DIR}/chain.crt"
        [ -f "$crt" ] || err "no staged certificate at $crt"
        [ -f "$key" ] || err "no staged private key at $key"
        validate_pair "$crt" "$key"
        if [ -f "$chain" ]; then
            openssl x509 -noout -in "$chain" >/dev/null 2>&1 \
                || err "staged chain is not valid PEM"
        fi

        install -o root -g root -m 0755 -d /etc/zenplus "$TLS_DIR"
        install -o root -g root -m 0600 "$key" "${TLS_DIR}/server.key"
        install -o root -g root -m 0644 "$crt" "${TLS_DIR}/server.crt"
        if [ -f "$chain" ]; then
            install -o root -g root -m 0644 "$chain" "${TLS_DIR}/chain.crt"
            cat "$crt" "$chain" > "${TLS_DIR}/fullchain.pem"
        else
            rm -f "${TLS_DIR}/chain.crt"
            cat "$crt" > "${TLS_DIR}/fullchain.pem"
        fi
        chmod 0644 "${TLS_DIR}/fullchain.pem"

        # The staged private key has served its purpose.
        rm -f "$key"

        # If HTTPS is already live, reload nginx so it picks up the new cert.
        if [ -f "$STATE_FILE" ] && grep -q '"https": *"on"' "$STATE_FILE"; then
            nginx -t >/dev/null 2>&1 || err "nginx config test failed after cert install"
            systemctl reload nginx
        fi
        echo "certificate installed"
        ;;

    apply)
        shift
        https="off"; redirect="off"; hsts="off"; min_tls="1.2"
        for arg in "$@"; do
            case "$arg" in
                https=on|https=off)       https="${arg#https=}" ;;
                redirect=on|redirect=off) redirect="${arg#redirect=}" ;;
                hsts=on|hsts=off)         hsts="${arg#hsts=}" ;;
                min_tls=1.2|min_tls=1.3)  min_tls="${arg#min_tls=}" ;;
                *) err "invalid argument: $arg" ;;
            esac
        done
        if [ "$https" = "on" ]; then
            [ -f "${TLS_DIR}/fullchain.pem" ] && [ -f "${TLS_DIR}/server.key" ] \
                || err "no certificate installed — run install-cert first"
        fi

        target=$(nginx_target)
        tmp="${target}.zpnew"
        bak="${target}.zpbak"
        generate_config "$tmp" "$https" "$redirect" "$hsts" "$min_tls"

        [ -f "$target" ] && cp -a "$target" "$bak"
        mv "$tmp" "$target"
        if ! nginx -t >/dev/null 2>&1; then
            # Roll back so the appliance never ends up with a broken web server.
            nginx -t 2>&1 | tail -5 >&2 || true
            if [ -f "$bak" ]; then mv "$bak" "$target"; else rm -f "$target"; fi
            err "generated nginx config failed validation — previous config restored"
        fi
        rm -f "$bak"
        systemctl reload nginx

        install -o root -g root -m 0755 -d /etc/zenplus "$TLS_DIR"
        cat > "$STATE_FILE" <<EOF
{"https": "$https", "redirect": "$redirect", "hsts": "$hsts", "min_tls": "$min_tls", "target": "$target"}
EOF
        chmod 0644 "$STATE_FILE"
        echo "applied: https=$https redirect=$redirect hsts=$hsts min_tls=$min_tls"
        ;;

    remove-cert)
        if [ -f "$STATE_FILE" ] && grep -q '"https": *"on"' "$STATE_FILE"; then
            err "HTTPS is enabled — disable it before removing the certificate"
        fi
        rm -f "${TLS_DIR}/server.key" "${TLS_DIR}/server.crt" \
              "${TLS_DIR}/chain.crt" "${TLS_DIR}/fullchain.pem"
        echo "certificate removed"
        ;;

    status)
        cert="none"
        [ -f "${TLS_DIR}/server.crt" ] && cert="installed"
        state="{}"
        [ -f "$STATE_FILE" ] && state=$(cat "$STATE_FILE")
        echo "{\"certificate\": \"$cert\", \"state\": $state}"
        ;;

    *)
        err "unknown subcommand: ${1:-<none>} (see script header for usage)"
        ;;
esac

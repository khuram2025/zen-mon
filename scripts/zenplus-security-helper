#!/bin/bash
# /opt/zenplus/scripts/zenplus-security-helper
#
# Privileged TLS / web-security operations for the ZenPlus API. The API runs
# as the unprivileged `zenplus` user; /etc/sudoers.d/zenplus-security grants
# it NOPASSWD access to the root-owned installed copy of this script at
# /usr/local/sbin/zenplus-security-helper. Every subcommand validates its
# arguments before touching anything — this script is a security boundary.
#
# The API never passes file contents or free-form config through this script:
# certificate material is staged by the API at fixed paths under
# /opt/zenplus/data/tls-staging, and the nginx config is generated here from
# an embedded template driven by a small set of validated flags. The zenplus
# user therefore cannot use the sudo grant to install arbitrary files or
# inject nginx directives.
#
# Subcommands:
#   install-cert                      Validate the staged cert/key (+ optional
#                                     chain) and install into /etc/zenplus/tls
#   apply https=on|off redirect=on|off hsts=on|off min_tls=1.2|1.3
#                                     Regenerate the ZenPlus nginx site config,
#                                     test it, reload nginx, record state
#   remove-cert                       Remove the installed certificate (refused
#                                     while HTTPS is active)
#   status                            JSON: installed cert + applied config
set -euo pipefail

STAGING_DIR="/opt/zenplus/data/tls-staging"
TLS_DIR="/etc/zenplus/tls"
STATE_FILE="${TLS_DIR}/state.json"
# Root-only scratch space for install-cert (a fresh mktemp -d per run).
CERT_WORK_PARENT="/tmp"
# Largest certificate, key or chain file accepted from the staging directory.
STAGED_MAX_BYTES=1048576

err() { echo "[security-helper] ERROR: $*" >&2; exit 1; }

# The active nginx site config for ZenPlus. Hand-installed appliances use
# sites-available/zenplus; installer-provisioned ones use conf.d/zenplus.conf.
nginx_target() {
    if [ -e /etc/nginx/sites-enabled/zenplus ]; then
        echo /etc/nginx/sites-available/zenplus
    else
        echo /etc/nginx/conf.d/zenplus.conf
    fi
}

# ── Certificate validation ──────────────────────────────────────────────────

validate_pair() {
    local crt="$1" key="$2"
    openssl x509 -noout -in "$crt" >/dev/null 2>&1 \
        || err "staged certificate is not a valid PEM X.509 certificate"
    openssl pkey -noout -passin pass: -in "$key" >/dev/null 2>&1 \
        || err "staged private key is not a valid PEM key"
    local crt_pub key_pub
    crt_pub=$(openssl x509 -pubkey -noout -in "$crt" | sha256sum | cut -d' ' -f1)
    key_pub=$(openssl pkey -pubout -passin pass: -in "$key" 2>/dev/null | sha256sum | cut -d' ' -f1)
    [ "$crt_pub" = "$key_pub" ] || err "private key does not match the certificate"
}

# Copy one staged file into the root-only work directory: $1 staging dir,
# $2 file name, $3 destination. The staging directory belongs to the service
# account, so its last component and the file are opened with O_NOFOLLOW (a
# symlink to /etc/shadow or another root-only file is refused), FIFOs and
# devices are refused, and the size is capped. Everything after this works on
# the root-owned copy, so the staged file cannot be swapped between validation
# and installation. Exit status: 0 copied, 3 absent, 2 refused.
snapshot_staged() {
    python3 -I - "$1" "$2" "$3" "$STAGED_MAX_BYTES" <<'PY'
import os, stat, sys

staging, name, destination, limit = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
parent, leaf = os.path.split(staging.rstrip("/"))
flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
try:
    parent_fd = os.open(parent or "/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    dir_fd = os.open(leaf, flags | os.O_DIRECTORY, dir_fd=parent_fd)
    fd = os.open(name, flags | os.O_NONBLOCK, dir_fd=dir_fd)
except FileNotFoundError:
    sys.exit(3)
except OSError as exc:
    print(f"{name}: {exc.strerror}", file=sys.stderr)
    sys.exit(2)
info = os.fstat(fd)
if not stat.S_ISREG(info.st_mode):
    print(f"{name}: not a regular file", file=sys.stderr)
    sys.exit(2)
chunks, size = [], 0
while True:
    chunk = os.read(fd, 65536)
    if not chunk:
        break
    size += len(chunk)
    if size > limit:
        print(f"{name}: larger than {limit} bytes", file=sys.stderr)
        sys.exit(2)
    chunks.append(chunk)
out = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
with os.fdopen(out, "wb") as handle:
    handle.write(b"".join(chunks))
PY
}

# Only parsed and re-encoded material is ever installed: whatever else a staged
# file contains (other PEM blocks, text, a key appended to a certificate) is
# dropped, so no file the service account points at is copied verbatim.
reencode_cert() {   # <in> <out>: the first X.509 certificate
    openssl x509 -in "$1" -out "$2" >/dev/null 2>&1 \
        || err "staged certificate is not a valid PEM X.509 certificate"
}

reencode_key() {    # <in> <out>: the private key, as unencrypted PKCS#8 PEM
    ( umask 077; openssl pkey -passin pass: -in "$1" -out "$2" >/dev/null 2>&1 ) \
        || err "staged private key is not a valid PEM key"
}

reencode_chain() {  # <in> <out>: every certificate, in order, PEM blocks only
    local blocks
    openssl crl2pkcs7 -nocrl -certfile "$1" 2>/dev/null \
        | openssl pkcs7 -print_certs 2>/dev/null \
        | awk '/^-----BEGIN CERTIFICATE-----$/ {p=1} p {print} /^-----END CERTIFICATE-----$/ {p=0}' \
        > "$2" || err "staged chain is not valid PEM"
    blocks=$(grep -c '^-----BEGIN CERTIFICATE-----$' "$2" || true)
    [ "${blocks:-0}" -ge 1 ] || err "staged chain is not valid PEM"
}

install_cert() {
    local work rc have_chain=0
    work=$(mktemp -d "${CERT_WORK_PARENT}/zenplus-cert.XXXXXXXX") \
        || err "cannot create a private work directory"
    chmod 0700 "$work"
    # shellcheck disable=SC2064  # expand $work now; it is local to this function
    trap "rm -rf -- '$work'" EXIT

    rc=0; snapshot_staged "$STAGING_DIR" server.crt "$work/crt.in" || rc=$?
    [ "$rc" -ne 3 ] || err "no staged certificate at ${STAGING_DIR}/server.crt"
    [ "$rc" -eq 0 ] || err "staged certificate is not a regular file (refused)"
    rc=0; snapshot_staged "$STAGING_DIR" server.key "$work/key.in" || rc=$?
    [ "$rc" -ne 3 ] || err "no staged private key at ${STAGING_DIR}/server.key"
    [ "$rc" -eq 0 ] || err "staged private key is not a regular file (refused)"
    rc=0; snapshot_staged "$STAGING_DIR" chain.crt "$work/chain.in" || rc=$?
    if [ "$rc" -eq 0 ]; then
        have_chain=1
    elif [ "$rc" -ne 3 ]; then
        err "staged chain is not a regular file (refused)"
    fi

    reencode_cert "$work/crt.in" "$work/server.crt"
    reencode_key "$work/key.in" "$work/server.key"
    validate_pair "$work/server.crt" "$work/server.key"
    if [ "$have_chain" -eq 1 ]; then
        reencode_chain "$work/chain.in" "$work/chain.crt"
        cat "$work/server.crt" "$work/chain.crt" > "$work/fullchain.pem"
    else
        cat "$work/server.crt" > "$work/fullchain.pem"
    fi

    install -o root -g root -m 0755 -d "$(dirname "$TLS_DIR")" "$TLS_DIR"
    install -o root -g root -m 0600 "$work/server.key" "${TLS_DIR}/server.key"
    install -o root -g root -m 0644 "$work/server.crt" "${TLS_DIR}/server.crt"
    if [ "$have_chain" -eq 1 ]; then
        install -o root -g root -m 0644 "$work/chain.crt" "${TLS_DIR}/chain.crt"
    else
        rm -f "${TLS_DIR}/chain.crt"
    fi
    install -o root -g root -m 0644 "$work/fullchain.pem" "${TLS_DIR}/fullchain.pem"

    # The staged private key has served its purpose. rm never follows a link.
    rm -f "${STAGING_DIR}/server.key"

    # If HTTPS is already live, reload nginx so it picks up the new cert.
    if [ -f "$STATE_FILE" ] && grep -q '"https": *"on"' "$STATE_FILE"; then
        nginx -t >/dev/null 2>&1 || err "nginx config test failed after cert install"
        systemctl reload nginx
    fi
    echo "certificate installed"
}

# ── Nginx config template ───────────────────────────────────────────────────
# Emits the shared proxy/static locations into $1. Mirrors the stock ZenPlus
# site config (install.sh) — keep the two in sync when locations change.
emit_locations() {
    cat >> "$1" <<'EOF'

    # BEGIN ZenPlus host-results ingest timeout
    # Host inventory uploads must never inherit the long-lived /api/ timeout.
    # The API has a shorter internal processing deadline and returns a
    # retryable response before the agent's 30-second HTTP timeout expires.
    location = /api/v1/agents/results/host {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
    }
    # END ZenPlus host-results ingest timeout

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # OTLP ingest (APM): OpenTelemetry SDKs/Collectors POST to /v1/traces.
    location /v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 32m;
        proxy_read_timeout 120s;
    }

    # Hashed assets are immutable.
    location ~* ^/assets/.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
        root /opt/zenplus/dashboard/dist;
        expires 7d;
        include /etc/nginx/snippets/zenplus-security-headers.conf;
        include /etc/nginx/snippets/zenplus-management-access*.conf;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # SPA shell — must not be cached so new builds are picked up immediately.
    location / {
        root /opt/zenplus/dashboard/dist;
        include /etc/nginx/snippets/zenplus-security-headers.conf;
        include /etc/nginx/snippets/zenplus-management-access*.conf;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
    }

    location /health {
        access_log off;
        proxy_pass http://127.0.0.1:8000/api/v1/system/health;
    }

    location ~ /\. {
        deny all;
    }
EOF
}

emit_security_headers() {
    cat >> "$1" <<'EOF'
    include /etc/nginx/snippets/zenplus-security-headers.conf;
    server_tokens off;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    gzip_min_length 1000;
EOF
}

write_security_headers() {
    mkdir -p /etc/nginx/snippets
    cat > /etc/nginx/snippets/zenplus-security-headers.conf <<'EOF'
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; frame-src 'self' blob: https:; worker-src 'self' blob:; form-action 'self'" always;
EOF
    if [ "$1" = "on" ]; then
        echo 'add_header Strict-Transport-Security "max-age=15768000" always;' >> /etc/nginx/snippets/zenplus-security-headers.conf
    fi
    chmod 0644 /etc/nginx/snippets/zenplus-security-headers.conf
}

generate_config() {
    local out="$1" https="$2" redirect="$3" hsts="$4" min_tls="$5"
    # A downloadable appliance cannot expose its public setup password remotely.
    # Only the authenticated root console creates the completion marker after
    # both independent administrator passwords have been replaced.
    local ipv4="" ipv6="[::]"
    if [ -f /etc/zentryc/cli-required ] && [ ! -f /var/lib/zentryc/console-setup-complete.json ]; then
        ipv4="127.0.0.1:"
        ipv6="[::1]"
    fi
    write_security_headers "$hsts"
    # Log without query strings (stream tickets, legacy ?token=). The format is
    # defined in nginx.conf's http block by setup-management-hardening.py; use
    # it only when present so `nginx -t` never fails on an unknown format.
    local access_log=""
    if grep -q 'log_format zenplus_safe ' /etc/nginx/nginx.conf 2>/dev/null; then
        access_log="    access_log /var/log/nginx/access.log zenplus_safe;"
    fi

    cat > "$out" <<'EOF'
# Generated by zenplus-security-helper — do not edit by hand.
# Changes are managed from Settings -> General -> Security.
EOF

    # ── HTTP :80 ──
    {
        echo "server {"
        echo "    listen ${ipv4}80 default_server;"
        echo "    listen ${ipv6}:80 default_server;"
        echo "    server_name _;"
        [ -z "$access_log" ] || echo "$access_log"
    } >> "$out"

    if [ "$https" = "on" ] && [ "$redirect" = "on" ]; then
        cat >> "$out" <<'EOF'

    # Health stays reachable over HTTP for load-balancer / monitor probes.
    location /health {
        access_log off;
        proxy_pass http://127.0.0.1:8000/api/v1/system/health;
    }

    location / {
        return 301 https://$host$request_uri;
    }
EOF
    else
        emit_security_headers "$out"
        emit_locations "$out"
    fi
    echo "}" >> "$out"

    # ── HTTPS :443 ──
    if [ "$https" = "on" ]; then
        {
            echo ""
            echo "server {"
            echo "    listen ${ipv4}443 ssl default_server;"
            echo "    listen ${ipv6}:443 ssl default_server;"
            # `http2 on;` requires nginx >= 1.25.1
            local ngx_ver
            ngx_ver=$(nginx -v 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            if [ -n "$ngx_ver" ] && printf '%s\n%s\n' "1.25.1" "$ngx_ver" | sort -V -C; then
                echo "    http2 on;"
            fi
            echo "    server_name _;"
            [ -z "$access_log" ] || echo "$access_log"
            echo ""
            echo "    ssl_certificate ${TLS_DIR}/fullchain.pem;"
            echo "    ssl_certificate_key ${TLS_DIR}/server.key;"
            if [ "$min_tls" = "1.3" ]; then
                echo "    ssl_protocols TLSv1.3;"
            else
                echo "    ssl_protocols TLSv1.2 TLSv1.3;"
            fi
            echo "    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;"
            echo "    ssl_prefer_server_ciphers off;"
            echo "    ssl_session_timeout 1d;"
            echo "    ssl_session_cache shared:ZenPlusSSL:10m;"
            echo "    ssl_session_tickets off;"
        } >> "$out"
        emit_security_headers "$out"
        emit_locations "$out"
        echo "}" >> "$out"
    fi
}

# ── Subcommands ─────────────────────────────────────────────────────────────

main() {
case "${1:-}" in
    install-cert)
        [ $# -eq 1 ] || err "usage: install-cert (reads ${STAGING_DIR})"
        install_cert
        ;;

    apply)
        shift
        https="off"; redirect="off"; hsts="off"; min_tls="1.2"
        for arg in "$@"; do
            case "$arg" in
                https=on|https=off)       https="${arg#https=}" ;;
                redirect=on|redirect=off) redirect="${arg#redirect=}" ;;
                hsts=on|hsts=off)         hsts="${arg#hsts=}" ;;
                min_tls=1.2|min_tls=1.3)  min_tls="${arg#min_tls=}" ;;
                *) err "invalid argument: $arg" ;;
            esac
        done
        if [ "$https" = "on" ]; then
            [ -f "${TLS_DIR}/fullchain.pem" ] && [ -f "${TLS_DIR}/server.key" ] \
                || err "no certificate installed — run install-cert first"
        fi

        target=$(nginx_target)
        tmp="${target}.zpnew"
        bak="${target}.zpbak"
        generate_config "$tmp" "$https" "$redirect" "$hsts" "$min_tls"

        [ -f "$target" ] && cp -a "$target" "$bak"
        mv "$tmp" "$target"
        if ! nginx -t >/dev/null 2>&1; then
            # Roll back so the appliance never ends up with a broken web server.
            nginx -t 2>&1 | tail -5 >&2 || true
            if [ -f "$bak" ]; then mv "$bak" "$target"; else rm -f "$target"; fi
            err "generated nginx config failed validation — previous config restored"
        fi
        rm -f "$bak"
        systemctl reload nginx

        install -o root -g root -m 0755 -d /etc/zenplus "$TLS_DIR"
        cat > "$STATE_FILE" <<EOF
{"https": "$https", "redirect": "$redirect", "hsts": "$hsts", "min_tls": "$min_tls", "target": "$target"}
EOF
        chmod 0644 "$STATE_FILE"
        echo "applied: https=$https redirect=$redirect hsts=$hsts min_tls=$min_tls"
        ;;

    remove-cert)
        if [ -f "$STATE_FILE" ] && grep -q '"https": *"on"' "$STATE_FILE"; then
            err "HTTPS is enabled — disable it before removing the certificate"
        fi
        rm -f "${TLS_DIR}/server.key" "${TLS_DIR}/server.crt" \
              "${TLS_DIR}/chain.crt" "${TLS_DIR}/fullchain.pem"
        echo "certificate removed"
        ;;

    status)
        cert="none"
        [ -f "${TLS_DIR}/server.crt" ] && cert="installed"
        state="{}"
        [ -f "$STATE_FILE" ] && state=$(cat "$STATE_FILE")
        echo "{\"certificate\": \"$cert\", \"state\": $state}"
        ;;

    *)
        err "unknown subcommand: ${1:-<none>} (see script header for usage)"
        ;;
esac
}

# Sourcing the helper (the test suite does) only defines its functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi

[Unit]
Description=ZenPlus First Boot Initialization
After=network-online.target postgresql.service redis-server.service docker.service
Wants=network-online.target
Requires=postgresql.service redis-server.service docker.service
Before=zenplus-wait-deps.service zenplus-api.service zenplus-poller.service nginx.service
ConditionPathExists=!/var/lib/zenplus/.initialized

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/zenplus
ExecStart=/opt/zenplus/bin/first-boot-init.sh
RemainAfterExit=yes
TimeoutStartSec=900
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target

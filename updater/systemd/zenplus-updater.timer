[Unit]
Description=ZenPlus OTA Update Check Timer
Documentation=https://zentryc.com/docs/updater

[Timer]
# Check 5 minutes after boot, then every 4 hours
OnBootSec=5min
OnUnitActiveSec=4h

# Randomize by up to 5 minutes to spread load across fleet
RandomizedDelaySec=300

Persistent=true

[Install]
WantedBy=timers.target

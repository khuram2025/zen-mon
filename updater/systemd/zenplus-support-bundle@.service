[Unit]
Description=ZenPlus Support Bundle Generator (%i)
After=network-online.target
Wants=network-online.target
Documentation=https://zentryc.com/docs/support-bundles

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/zenplus
Environment=PYTHONPATH=/opt/zenplus
EnvironmentFile=-/opt/zenplus/.env
ExecStart=/opt/zenplus/venv/bin/python -m support --job %i

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zenplus-support

# Bundle generation should never take more than 10 minutes.
TimeoutStartSec=600

# Hardening: the worker only needs to read everywhere and write to one dir.
ProtectSystem=full
ReadWritePaths=/opt/zenplus/support /tmp /var/log
PrivateTmp=true
NoNewPrivileges=true
